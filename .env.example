# Copia este fichero como .env (en la raiz del repo) y rellena tus valores.
# El .env NUNCA se sube a GitHub: esta en .gitignore. En Azure, estos valores van como secretos de la Container App.

# Neon · console.neon.tech -> tu proyecto -> Connect -> connection string (la misma de la Sesion 9)
DATABASE_URL=postgresql://usuario:contrasena@ep-xxxx.neon.tech/neondb?sslmode=require

# LangFuse Cloud · Settings -> API Keys (las mismas de la Sesion 6)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# Azure OpenAI · los imprime azure/desplegar.sh (o portal: tu recurso -> Keys and Endpoint)
# Si dejas AZURE_OPENAI_ENDPOINT vacio, el agente usa llama3.1 con Ollama en tu portatil.
AZURE_OPENAI_ENDPOINT=https://TU-RECURSO.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
OPENAI_API_VERSION=2024-10-21

# Servidor MCP: en local http://localhost:8000. En Azure no hace falta: el chatbot usa http://mcp-tienda
MCP_URL=http://localhost:8000
